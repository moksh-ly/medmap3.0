# Server Port (Render automatically supplies PORT in production)
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.rvhhbg4.mongodb.net/medmap?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication Secret Key
JWT_SECRET=

# Seed Accounts Credentials
ADMIN_ID=115
ADMIN_PASSWORD=
PHARMACIST_ID=116
PHARMACIST_PASSWORD=

# Optional: CORS allowed origin if frontend is deployed separately (e.g. Vercel)
# CORS_ORIGIN=https://your-medmap-frontend.vercel.app

# Optional (Frontend only): API base URL if frontend is deployed separately from the backend
# VITE_API_BASE_URL=https://your-medmap-backend.onrender.com